{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Slice",
  "version": "0.1.0",
  "identifier": "com.sliceplayer.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Slice",
        "url": "http://127.0.0.1:3000",
        "width": 1400,
        "height": 900,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
